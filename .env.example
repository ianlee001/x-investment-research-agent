# Copy to .env. Never commit keys. Existing .env files are not overwritten by setup.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
TAVILY_API_KEY=
X_BEARER_TOKEN=
MASSIVE_API_KEY=
# Must identify your application and contain your actual contact email.
SEC_USER_AGENT=
# setup-local.ps1 creates a separate .env.local containing the local database URL.
DATABASE_URL=postgresql://xresearch:change-me@127.0.0.1:55432/xresearch
APP_HOST=127.0.0.1
APP_PORT=8765
# Required if binding to a non-loopback address. Keep browser token out of URLs.
APP_AUTH_TOKEN=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
TIMEZONE=Asia/Shanghai
MASSIVE_REQUESTS_PER_MINUTE=5
MAX_MODEL_CALLS=14
MAX_TOOL_CALLS=18
MAX_EXTERNAL_REQUESTS=30
MAX_TOTAL_TOKENS=60000
RUN_TIMEOUT_SECONDS=420
X_SYNC_MAX_PAGES=3
X_PAGE_SIZE=20
X_SEARCH_ENABLED=false
